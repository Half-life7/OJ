# 含 2D 全链路的开发环境；复制为 deploy/.env 并填写所有空白密钥。
# Go 程序本身不会自动读取 .env，Compose 使用 --env-file 及显式 environment 导入。
APP_ENV=development
APP_PORT=8080
PUBLIC_HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
TIMEZONE=Asia/Shanghai
LOG_LEVEL=info

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=biue
MYSQL_USER=biue
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# 三个独立随机值，各至少32字节；禁止复用或填写示例口令。
JWT_SECRET=
CSRF_SECRET=
APP_ENCRYPTION_KEY=
AUTH_SESSION_TTL=12h
BCRYPT_COST=12

# 宿主机直接运行时的测试数据目录；Compose 固定使用容器专用持久卷。
PROBLEM_DATA_DIR=oj-data/problem-data
PROBLEM_IMPORT_CONCURRENCY=2
JUDGE_QUEUE_CAPACITY=1000

# Worker -> Runner 的第四个独立随机密钥；仅注入 Worker 与 Runner。
RUNNER_TOKEN=
RUNNER_URL=http://runner:8083
JUDGE_CONCURRENCY=2
# Linux Docker Socket 的 GID，使用 stat -c '%g' /var/run/docker.sock 查询。
DOCKER_GID=0
RUNNER_CA_FILE=
RUNNER_TLS_CERT=
RUNNER_TLS_KEY=

# 仅信任本开发 Compose 中固定地址的 Nginx。
# 修改 edge 网段或 Nginx 地址时同步修改此处。
# 直接在宿主机启动 Go 且无反向代理时设为空。
TRUSTED_PROXY_CIDRS=172.30.0.10/32
